rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'abdallahbayoumi1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
        'id', 'name', 'date', 'isActive', 'deliverableItems',
        'displayFields', 'searchFields', 'totalParticipants', 'ownerUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'date', 'isActive', 'registrationStatus', 'registrationOpensAt', 'registrationClosesAt',
        'deliverableItems', 'displayFields', 'displayLabels', 'searchFields', 'totalParticipants', 'ownerUid', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.date is string && data.date.size() >= 1 && data.date.size() <= 40 &&
      data.isActive is bool &&
      (!('registrationStatus' in data) || data.registrationStatus in ['auto', 'open', 'closed']) &&
      (!('registrationOpensAt' in data) || (data.registrationOpensAt is string && data.registrationOpensAt.size() <= 40)) &&
      (!('registrationClosesAt' in data) || (data.registrationClosesAt is string && data.registrationClosesAt.size() <= 40)) &&
      data.deliverableItems is list && data.deliverableItems.size() <= 20 &&
      data.displayFields is list && data.displayFields.size() <= 20 &&
      (!('displayLabels' in data) || data.displayLabels is map) &&
      data.searchFields is list && data.searchFields.size() <= 10 &&
      data.totalParticipants is int && data.totalParticipants >= 0 &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidOrganizer(data) {
      return data.keys().hasAll([
        'id', 'eventId', 'name', 'assignedItems', 'magicToken', 'isActive', 'deliveredCount', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'eventId', 'name', 'boothName', 'whatsappPhone', 'assignedItems', 'magicToken', 'isActive', 'deliveredCount', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.eventId) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      (!('boothName' in data) || (data.boothName is string && data.boothName.size() <= 120)) &&
      (!('whatsappPhone' in data) || (data.whatsappPhone is string && data.whatsappPhone.size() <= 30)) &&
      data.assignedItems is list && data.assignedItems.size() <= 20 &&
      isValidId(data.magicToken) &&
      data.isActive is bool &&
      data.deliveredCount is int && data.deliveredCount >= 0 &&
      data.createdAt is timestamp;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['barcode', 'searchKeywords', 'dynamicData', 'deliveries']) &&
      data.keys().hasOnly(['barcode', 'searchKeywords', 'dynamicData', 'deliveries']) &&
      isValidId(data.barcode) &&
      data.searchKeywords is list && data.searchKeywords.size() <= 60 &&
      (data.searchKeywords.size() == 0 || data.searchKeywords[0] is string) &&
      data.dynamicData is map &&
      data.deliveries is map;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['participantName', 'barcode', 'itemName', 'organizerName', 'action', 'timestamp']) &&
      data.keys().hasOnly(['participantName', 'barcode', 'itemId', 'itemName', 'organizerId', 'organizerName', 'action', 'timestamp']) &&
      data.participantName is string && data.participantName.size() >= 1 && data.participantName.size() <= 200 &&
      data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 128 &&
      (!('itemId' in data) || (data.itemId is string && data.itemId.size() <= 128)) &&
      data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 120 &&
      (!('organizerId' in data) || (data.organizerId is string && data.organizerId.size() <= 128)) &&
      data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 120 &&
      data.action in ['delivered', 'undone'] &&
      data.timestamp == request.time;
    }

    // Admins registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Health check probe doc
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Events collection (schema-validated for passcode admin & magic-link organizers)
    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if existing().ownerUid == 'admin';
      allow create: if isValidId(eventId) && isValidEvent(incoming()) &&
        incoming().id == eventId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(eventId) && isValidEvent(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'date', 'isActive', 'registrationStatus', 'registrationOpensAt', 'registrationClosesAt',
          'deliverableItems', 'displayFields', 'displayLabels', 'searchFields', 'totalParticipants'
        ]);
      allow delete: if isValidId(eventId);

      // Participants sub-collection (strictly scoped under eventId)
      match /participants/{barcode} {
        allow get: if isValidId(eventId) && isValidId(barcode);
        allow list: if isValidId(eventId) &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow create: if isValidId(eventId) && isValidId(barcode) &&
          isValidParticipant(incoming()) &&
          incoming().barcode == barcode &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow update: if isValidId(eventId) && isValidId(barcode) &&
          isValidParticipant(incoming()) &&
          incoming().barcode == existing().barcode &&
          incoming().diff(existing()).affectedKeys().hasOnly(['deliveries', 'dynamicData', 'searchKeywords']);
        allow delete: if isValidId(eventId) && isValidId(barcode);
      }

      // Immutable activity logs sub-collection
      match /activity_logs/{logId} {
        allow get: if isValidId(eventId) && isValidId(logId);
        allow list: if isValidId(eventId) &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow create: if isValidId(eventId) && isValidId(logId) &&
          isValidActivityLog(incoming()) &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow update, delete: if false;
      }
    }

    // Organizers collection (scoped by eventId + magicToken)
    match /organizers/{organizerId} {
      allow get: if isValidId(organizerId);
      allow list: if request.query.limit <= 500;
      allow create: if isValidId(organizerId) && isValidOrganizer(incoming()) &&
        incoming().id == organizerId &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/events/$(incoming().eventId));
      allow update: if isValidId(organizerId) && isValidOrganizer(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().eventId == existing().eventId &&
        incoming().magicToken == existing().magicToken &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'boothName', 'whatsappPhone', 'assignedItems', 'isActive', 'deliveredCount'
        ]);
      allow delete: if isValidId(organizerId);
    }
  }
}
